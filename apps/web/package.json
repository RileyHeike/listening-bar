{
  "name": "@bar/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:site": "BAR_API=off astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "astro sync && eslint --max-warnings=0 . && stylelint \"src/**/*.{css,astro}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "visual:compare": "tsx visual/compare.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@bar/content": "workspace:*",
    "@bar/core": "workspace:*",
    "@bar/room": "workspace:*",
    "@bar/tokens": "workspace:*",
    "@bar/ui": "workspace:*",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@bar/fixtures": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

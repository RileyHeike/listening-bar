---
import { Button } from '@bar/ui';
import Base from '../layouts/Base.astro';
---

<Base page={{ id: 'not-found', title: 'Not found', tone: 'room' }}>
  <div class="page lost">
    <p class="lost__kicker">Side C</p>
    <h1>This record doesn't exist.</h1>
    <p>Maybe it was never pressed. The room is this way.</p>
    <Button href="/" variant="outline">
      Back to the room
    </Button>
  </div>
</Base>

<style>
  .lost {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding-block: var(--space-6);
  }

  .lost__kicker {
    color: var(--room-glow);
    font: 400 var(--type-sm) / 1 var(--font-mono);
  }

  .lost h1 {
    font-size: var(--type-xl);
  }
</style>

---
import type { StationContext } from '@bar/core';
import { Crest } from '@bar/ui';
import './site-footer.css';

type Props = StationContext;
const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <a class="site-footer__sign" href="/">
      <Crest size="1.75rem" />
      <span>{site.name}</span>
    </a>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/">The room</a>
      {site.nav.map((entry) => (
        <a href={entry.route}>{entry.name}</a>
      ))}
    </nav>
    <p class="site-footer__note">
      A listening bar on the internet. Set in Jost, Shippori Mincho and DM Mono.
    </p>
    <p class="site-footer__copy">© {year} [Your Name]</p>
  </div>
</footer>

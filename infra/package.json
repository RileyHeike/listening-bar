{
  "name": "@bar/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CDK app: discovers modules, provisions per-environment stacks.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "synth": "cdk synth",
    "sandbox:deploy": "tsx scripts/sandbox.ts deploy",
    "sandbox:watch": "tsx scripts/sandbox.ts watch",
    "sandbox:destroy": "tsx scripts/sandbox.ts destroy"
  },
  "dependencies": {
    "@bar/core": "workspace:*",
    "@bar/server": "workspace:*",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

{
  "name": "@bar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server glue for modules: Hono app builder, publisher, room-state, secrets, logging.",
  "exports": {
    ".": "./src/index.ts",
    "./lambda": "./src/lambda.ts",
    "./authorizer": "./src/authorizer.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/parameters": "2.36.0",
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "@aws-sdk/credential-provider-node": "3.972.88",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@bar/core": "workspace:*",
    "@hono/aws-lambda": "1.0.1",
    "@smithy/signature-v4": "5.7.4",
    "dynamodb-toolbox": "2.11.1",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
